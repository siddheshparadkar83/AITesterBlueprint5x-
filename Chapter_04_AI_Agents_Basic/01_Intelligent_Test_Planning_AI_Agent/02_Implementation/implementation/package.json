{
  "name": "jira-test-plan-generator",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix src/frontend install",
    "dev": "concurrently -k \"npm --prefix src/frontend run dev\" \"node src/backend/server.js\"",
    "build": "npm --prefix src/frontend run build",
    "start": "node src/backend/server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
